# OpenAI API Key (required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Server Port (optional, defaults to 3001)
PORT=3001

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Required in production — without it every browser request is rejected.
# In development, http://localhost:5173 is always allowed automatically.
# Example: ALLOWED_ORIGINS=https://fogcast.vercel.app,https://www.fogcast.app
ALLOWED_ORIGINS=
